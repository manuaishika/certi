# ---------------- Front end (Vite) ----------------
# Leave both unset to run in DEMO mode (in-browser Postgres, seeded demo accounts, mock payments).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
# Public origin used in QR codes / share links (defaults to window.location.origin)
VITE_PUBLIC_URL=https://cergema.mangalhands.com

# ---------------- Edge Function secrets ----------------
# set with:  supabase secrets set --env-file supabase/.env.secrets
PUBLIC_URL=https://cergema.mangalhands.com
CRON_SECRET=<long random string>

# Payments (Super Admin switches Settings > gateway to "live" once these are set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI background providers (first configured wins: FLUX, then Imagen; none = built-in generator)
FAL_KEY=
GEMINI_API_KEY=

# Notifications (each channel is skipped when unset)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WA_FROM=
RESEND_API_KEY=
EMAIL_FROM="CerGeMA <certificates@mangalhands.com>"
